{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/_vercel/(.*)",
      "destination": "/_vercel/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/web/$1"
    }
  ]
}
